theorem checkIndexed_append {α : Type} (predicate : Nat → α → Bool)
    (start : Nat) (xs ys : List α) :
    checkIndexed predicate start (xs ++ ys) =
      (checkIndexed predicate start xs &&
        checkIndexed predicate (start + xs.length) ys) := by
  induction xs generalizing start with
  | nil => simp [checkIndexed]
  | cons x xs ih =>
      simp [checkIndexed, ih, Nat.add_comm, Nat.add_left_comm,
        Bool.and_assoc]

def checkIndexed_chunks {α : Type} (predicate : Nat → α → Bool)
    (start : Nat) : List (List α) → Bool
  | [] => true
  | chunk :: rest =>
      checkIndexed predicate start chunk &&
        checkIndexed_chunks predicate (start + chunk.length) rest

theorem checkIndexed_chunks_append {α : Type} (predicate : Nat → α → Bool)
    (start : Nat) (xs ys : List (List α)) :
    checkIndexed_chunks predicate start (xs ++ ys) =
      (checkIndexed_chunks predicate start xs &&
        checkIndexed_chunks predicate (start + xs.flatten.length) ys) := by
  induction xs generalizing start with
  | nil => simp [checkIndexed_chunks]
  | cons x xs ih =>
      simp [checkIndexed_chunks, ih, Bool.and_assoc, Nat.add_assoc]

theorem checkIndexed_flatten {α : Type} (predicate : Nat → α → Bool)
    (start : Nat) (chunks : List (List α)) :
    checkIndexed predicate start chunks.flatten =
      checkIndexed_chunks predicate start chunks := by
  induction chunks generalizing start with
  | nil => simp only [List.flatten, checkIndexed, checkIndexed_chunks]
  | cons chunk rest ih =>
      rw [List.flatten_cons, checkIndexed_append, ih]
      rfl

