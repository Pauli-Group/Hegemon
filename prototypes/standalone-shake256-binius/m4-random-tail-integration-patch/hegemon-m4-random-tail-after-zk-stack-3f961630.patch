+	/// Proves the one-main n15 system with fresh randomness in every whole unused B128 tail symbol.
+	///
+	/// All structural admission checks happen before the transcript is touched. The verifier is
+	/// unchanged: it derives the same n15 oracle dimension from the constraint system. This method
+	/// returns the exact active prefix chosen by the compiled circuit, but it does not establish
+	/// zero knowledge; the complete adaptive PCS observation matrix still requires a separate
+	/// export/audit interface.
+	pub fn prove_main_with_random_trace_tail<Challenger_>(
+		&self,
+		witness: &WitnessM4,
+		rng: impl CryptoRng,
+		transcript: &mut ProverTranscript<Challenger_>,
+	) -> Result<RandomTraceTailGeometry, RandomTraceTailError>
+	where
+		Challenger_: Challenger,
+	{
+		let expected_geometry = self.random_trace_tail_geometry(witness)?;
+
+		let alloc = &self.pool;
+		let mut channel = self
+			.basefold_compiler
+			.create_channel_without_zk_from_transcript::<H, Challenger_, _, _>(transcript, alloc);
+		let geometry = self
+			.iop_prover
+			.main
+			.prove_with_random_trace_tail::<_, P, _>(&witness.main, rng, &mut channel, &alloc)?;
+		debug_assert_eq!(geometry, expected_geometry);
+
+		let _scope = tracing::debug_span!("PCS opening").entered();
+		channel.finish();
+
+		Ok(geometry)
+	}
+
+	/// Exports the exact compiled active-prefix and tail counts without proving.
+	///
+	/// This performs the same fail-closed structural admission as
+	/// [`Self::prove_main_with_random_trace_tail`] but consumes neither transcript bytes nor prover
+	/// randomness.
+	pub fn random_trace_tail_geometry(
+		&self,
+		witness: &WitnessM4,
+	) -> Result<RandomTraceTailGeometry, RandomTraceTailError> {
+		if !self.iop_prover.chips.is_empty() {
+			return Err(RandomTraceTailError::NumberedChips(self.iop_prover.chips.len()));
+		}
+		if !witness.tables.is_empty() {
+			return Err(RandomTraceTailError::WitnessTables(witness.tables.len()));
+		}
+
+		let main = &self.iop_prover.main;
+		let n_intmul = main.constraint_system().n_imul_constraints();
+		if n_intmul != 0 {
+			return Err(RandomTraceTailError::IntMulConstraints(n_intmul));
+		}
+
+		let specs = self.basefold_compiler.oracle_specs();
+		if specs.len() != 1 {
+			return Err(RandomTraceTailError::OracleCount(specs.len()));
+		}
+		let spec = specs[0];
+		if spec.log_msg_len != RANDOM_TAIL_LOG_TRACE_SYMBOLS {
+			return Err(RandomTraceTailError::WrongTraceTier {
+				expected: RANDOM_TAIL_LOG_TRACE_SYMBOLS,
+				actual: spec.log_msg_len,
+			});
+		}
+		if main.log_witness_elems() != spec.log_msg_len {
+			return Err(RandomTraceTailError::WrongTraceTier {
+				expected: spec.log_msg_len,
+				actual: main.log_witness_elems(),
+			});
+		}
+		if spec.is_zk {
+			return Err(RandomTraceTailError::AlreadyMaskedOracle);
+		}
+
+		Ok(main.random_trace_tail_geometry(&witness.main)?)
+	}
 }
 
