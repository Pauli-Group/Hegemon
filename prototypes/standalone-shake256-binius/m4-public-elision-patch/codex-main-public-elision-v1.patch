+/// Evaluates a public word slice carried by the verifier channel.
+///
+/// The channel's `subset_sum` operation evaluates one word at the bit-index point without any
+/// prover message. Missing words in the power-of-two span contribute zero.
+pub fn evaluate_channel_words_mle<F, C>(
+	channel: &mut C,
+	words: &[C::Word],
+	r_j: &[C::Elem],
+	r_y: &[C::Elem],
+) -> C::Elem
+where
+	F: BinaryField,
+	C: WordIPVerifierChannel<F>,
+	C::Elem: FieldOps<Scalar = F> + From<F>,
+{
+	assert_eq!(r_j.len(), Word::LOG_BITS);
+	assert!(words.len() <= 1 << r_y.len());
+
+	let r_j_tensor = eq_ind_partial_eval_scalars(r_j);
+	let r_y_tensor = eq_ind_partial_eval_scalars(r_y);
+	iter::zip(words, r_y_tensor)
+		.map(|(word, weight)| weight * channel.subset_sum(&r_j_tensor, word))
+		.sum()
+}
