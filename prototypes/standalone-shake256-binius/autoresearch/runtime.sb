(version 1)

; Candidate-linked test and prover/verifier binaries run under this stricter
; second-stage policy. Compilation occurs before this stage. The binary may
; create threads and read its source/toolchain closure, but it may not fork,
; exec, register launchd jobs, signal external processes, look up Mach/XPC
; services, use the network, change process groups, or write outside TMPDIR.
(allow default)
(deny network*)
(deny job-creation)
(deny signal)
(deny process-fork)
(deny process-info*)
(deny process-exec*)
(allow process-exec* (literal (param "EXECUTABLE")))
(deny mach-lookup)
(deny ipc-posix*)
(deny syscall-unix (syscall-number SYS_setpgid))
(deny syscall-unix (syscall-number SYS_setsid))
(deny file-read*)
(allow file-read* (literal "/"))
(allow file-read-metadata (literal "/private"))
(allow file-read-metadata (literal "/private/var"))
(allow file-read-metadata (subpath "/private/var/folders"))
(allow file-read-metadata (literal "/var"))
(allow file-read-metadata (literal "/Library"))
(allow file-read-metadata (literal "/Library/Frameworks"))
(allow file-read* (literal (param "EXECUTABLE")))
(allow file-read* (subpath (param "TARGET_DIR")))
(allow file-read* (subpath (param "TMP_DIR")))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr/lib"))
(allow file-read* (subpath "/Library/Apple"))
(allow file-read* (subpath "/private/var/db/timezone"))
(allow file-read* (subpath "/private/var/select"))
(allow file-read* (subpath "/dev"))
(deny file-read* (literal (param "MARKER")))
(deny file-write*)
(allow file-write* (literal "/dev/null"))
(allow file-write* (subpath (param "TMP_DIR")))
(deny file-read* (literal (param "MARKER")))
(deny file-write* (literal (param "MARKER")))
