(version 1)

; The candidate patch has been applied, but its Rust source is only compiled in
; this phase. Read access is limited to the owned run closure, immutable
; evaluator scripts, the offline Rust/Cargo closure, and operating-system
; files. This blocks include_bytes!/proc-macro/linker reads of user secrets.
(allow default)
(deny network*)
(deny job-creation)
(deny signal)
(deny syscall-unix (syscall-number SYS_setpgid))
(deny syscall-unix (syscall-number SYS_setsid))

(deny file-read*)
(allow file-read* (literal "/"))
(allow file-read-metadata (literal "/private"))
(allow file-read-metadata (literal "/private/var"))
(allow file-read-metadata (subpath "/private/var/folders"))
(allow file-read-metadata (subpath (param "RUN_PARENT")))
(allow file-read-metadata (literal "/Users"))
(allow file-read-metadata (literal (param "USER_ROOT")))
(allow file-read-metadata (literal (param "CARGO_PARENT")))
(allow file-read-metadata (literal "/etc"))
(allow file-read-metadata (literal "/Library"))
(allow file-read-metadata (literal "/Library/Developer"))
(allow file-read-metadata (literal "/Library/Frameworks"))
(allow file-read* (subpath (param "RUN_DIR")))
(allow file-read* (subpath (param "EVALUATOR_DIR")))
(allow file-read* (literal (param "MEASURE_SCRIPT")))
(allow file-read* (subpath (param "CARGO_BIN")))
(allow file-read* (subpath (param "CARGO_REGISTRY")))
(allow file-read* (subpath (param "CARGO_GIT")))
(allow file-read* (subpath (param "RUSTUP_ROOT")))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/Library/Apple"))
(allow file-read* (subpath "/Library/Developer/CommandLineTools"))
(allow file-read* (subpath "/private/var/db/timezone"))
(allow file-read* (subpath "/private/var/select"))
(allow file-read* (literal "/private/etc/ssl/openssl.cnf"))
(allow file-read* (subpath "/dev"))
(deny file-read* (literal (param "MARKER")))

(deny file-write*)
(allow file-write* (literal "/dev/null"))
(allow file-write* (subpath (param "TARGET_DIR")))
(allow file-write* (subpath (param "TMP_DIR")))
(allow file-write* (subpath (param "HOME_DIR")))
(allow file-write* (subpath (param "CARGO_HOME")))
(allow file-write* (subpath (param "LOGS_DIR")))
(deny file-write* (literal (param "MARKER")))
