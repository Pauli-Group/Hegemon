+	/// Assigns the next pinned private input wire.
+	///
+	/// Private operation outputs share this allocator, so inputs must be written in allocation
+	/// order before evaluating operations that depend on them. The equality assertion catches a
+	/// circuit/witness traversal mismatch instead of silently aliasing an operation output.
+	pub fn write_private(&mut self, wire: ConstraintWire, value: F) -> WitnessWire<F> {
