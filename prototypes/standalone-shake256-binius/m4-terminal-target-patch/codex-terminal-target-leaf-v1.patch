+	fn send_openings_omitting_fold_targets<P: PackedField<Scalar = F>>(
+		&mut self,
+		commitment: &Self::Commitment,
+		data: FieldSlice<P>,
+		indices: &[Word],
+		fold_challenges: &[F],
+	) {
+		let tree_depth = commitment.depth;
+		debug_assert_eq!(tree_depth, data.log_len() - commitment.log_leaf_size);
+		let leaf_size = 1 << commitment.log_leaf_size;
+		assert_eq!(leaf_size, 1 << fold_challenges.len());
+
+		let indices = indices
+			.iter()
+			.map(|index| index.as_u64() as usize)
+			.collect::<Vec<_>>();
+		assert!(indices.iter().all(|&index| index < 1 << tree_depth));
+		let mut unique_indices = indices;
+		unique_indices.sort_unstable();
+		unique_indices.dedup();
+		let mut advice = self.transcript.borrow_mut().decommitment();
+		for &index in &unique_indices {
+			let leaf = data.chunk(commitment.log_leaf_size, index);
+			let values = leaf.iter_scalars().collect::<Vec<_>>();
+			let (_, slopes) = decompose_multilinear_evaluation(&values, fold_challenges);
+			advice.write_scalar_iter(slopes);
+		}
+
+		let branches = unique_indices
+			.iter()
+			.map(|&index| {
+				commitment
+					.committed
+					.branch(index, 0)
+					.expect("precondition: every distinct query index is in the committed tree")
+			})
+			.collect::<Vec<_>>();
+		let mut live = unique_indices
+			.iter()
+			.copied()
+			.enumerate()
+			.map(|(representative, index)| (index, representative))
+			.collect::<BTreeMap<_, _>>();
+		for level in 0..tree_depth {
+			let mut parents = BTreeMap::new();
+			for (&index, &representative) in &live {
+				let sibling = index ^ 1;
+				if index & 1 == 1 && live.contains_key(&sibling) {
+					continue;
+				}
+				if !live.contains_key(&sibling) {
+					advice.write(&branches[representative][level]);
+				}
+				parents.entry(index >> 1).or_insert(representative);
+			}
+			live = parents;
+		}
+		debug_assert_eq!(live.len(), 1);
+	}
+
