+/// Re-encodes a multilinear evaluation table as its final value and division-free fold slopes.
+///
+/// Slopes are returned in inverse fold order, with level sizes `1, 2, 4, ...`. Together with the
+/// final value and evaluation point, they form a bijective representation of the original table.
+pub fn decompose_multilinear_evaluation<F: FieldOps>(values: &[F], point: &[F]) -> (F, Vec<F>) {
+	assert_eq!(values.len(), 1 << point.len(), "precondition: values length must be 2^point.len()");
+
+	let mut current = values.to_vec();
+	let mut levels = Vec::with_capacity(point.len());
+	for point_i in point.iter().rev() {
+		let half_len = current.len() >> 1;
+		let mut next = Vec::with_capacity(half_len);
+		let mut slopes = Vec::with_capacity(half_len);
+		for j in 0..half_len {
+			let lo = current[j].clone();
+			let delta = current[j + half_len].clone() - lo.clone();
+			next.push(lo + point_i.clone() * delta.clone());
+			slopes.push(delta);
+		}
+		levels.push(slopes);
+		current = next;
+	}
+
+	let target = current[0].clone();
+	let slopes = levels.into_iter().rev().flatten().collect();
+	(target, slopes)
+}
+
+/// Reconstructs a multilinear evaluation table from its final value and division-free slopes.
+pub fn reconstruct_multilinear_evaluations<F: FieldOps>(
+	target: F,
+	slopes: &[F],
+	point: &[F],
+) -> Vec<F> {
+	assert_eq!(slopes.len(), (1 << point.len()) - 1, "precondition: exact slope count");
+
+	let mut current = vec![target];
+	let mut offset = 0;
+	for point_i in point {
+		let width = current.len();
+		let level = &slopes[offset..offset + width];
+		let mut lower = Vec::with_capacity(width);
+		let mut upper = Vec::with_capacity(width);
+		for (out, delta) in current.into_iter().zip(level) {
+			let lo = out - point_i.clone() * delta.clone();
+			upper.push(lo.clone() + delta.clone());
+			lower.push(lo);
+		}
+		lower.extend(upper);
+		current = lower;
+		offset += width;
+	}
+	current
+}
