diff --git a/crates/ip-prover/src/sumcheck/grouped.rs b/crates/ip-prover/src/sumcheck/grouped.rs
new file mode 100644
index 00000000..73ba6771
--- /dev/null
+++ b/crates/ip-prover/src/sumcheck/grouped.rs
@@ -0,0 +1,161 @@
+// Copyright 2026 The Binius Developers
+
+//! A sumcheck prover for one claim that is the sum of several independently represented terms.
+//!
+//! [`GroupedSumcheckProver`] is only a round combiner. Each inner prover retains its own
+//! multilinear representation, including its own native variable count before padding. The
+//! wrapper adds round polynomials coefficient-wise and folds every term at the same challenge.
+//! No per-term claim is serialized.
+
+use std::marker::PhantomData;
+
+use binius_field::Field;
+use binius_ip::sumcheck::RoundCoeffs;
+
+use super::common::SumcheckProver;
+
+/// Proves one sumcheck claim equal to the sum of several one-claim inner provers.
+pub struct GroupedSumcheckProver<F: Field, Inner> {
+	inners: Vec<Inner>,
+	_marker: PhantomData<F>,
+}
+
+impl<F: Field, Inner: SumcheckProver<F>> GroupedSumcheckProver<F, Inner> {
+	/// Builds one aggregate prover from `(term_claim, term_prover)` pairs.
+	///
+	/// The claims are supplied separately because [`SumcheckProver`] intentionally does not expose
+	/// them. Their sum must equal `aggregate_claim`, and every inner prover must expose the same
+	/// number of rounds after any caller-owned padding.
+	pub fn new(terms: impl IntoIterator<Item = (F, Inner)>, aggregate_claim: F) -> Self {
+		let (claims, inners): (Vec<_>, Vec<_>) = terms.into_iter().unzip();
+		assert!(!inners.is_empty(), "a grouped sumcheck must contain at least one term");
+		assert_eq!(
+			claims.iter().copied().sum::<F>(),
+			aggregate_claim,
+			"the term claims must sum to the aggregate claim"
+		);
+		let n_vars = inners[0].n_vars();
+		assert!(
+			inners.iter().all(|inner| inner.n_vars() == n_vars),
+			"all grouped sumcheck terms must expose the same number of variables"
+		);
+
+		Self {
+			inners,
+			_marker: PhantomData,
+		}
+	}
+}
+
+impl<F, Inner> SumcheckProver<F> for GroupedSumcheckProver<F, Inner>
+where
+	F: Field,
+	Inner: SumcheckProver<F>,
+{
+	fn n_vars(&self) -> usize {
+		self.inners[0].n_vars()
+	}
+
+	fn execute(&mut self) -> Vec<RoundCoeffs<F>> {
+		let aggregate = self
+			.inners
+			.iter_mut()
+			.map(|inner| {
+				let [coeffs]: [RoundCoeffs<F>; 1] = inner
+					.execute()
+					.try_into()
+					.expect("each grouped term must carry exactly one claim");
+				coeffs
+			})
+			.sum();
+		vec![aggregate]
+	}
+
+	fn fold(&mut self, challenge: F) {
+		for inner in &mut self.inners {
+			inner.fold(challenge);
+		}
+	}
+
+	fn finish(self) -> Vec<F> {
+		self.inners
+			.into_iter()
+			.flat_map(SumcheckProver::finish)
+			.collect()
+	}
+}
+
+#[cfg(test)]
+mod tests {
+	use binius_compute::GlobalAllocator;
+	use binius_field::arch::{OptimalB128 as F, OptimalPackedB128 as P};
+	use binius_ip::sumcheck::verify;
+	use binius_math::{inner_product::inner_product_par, test_utils::random_field_buffer};
+	use binius_transcript::{ProverTranscript, fiat_shamir::HasherChallenger};
+	use rand::{SeedableRng, rngs::StdRng};
+
+	use super::*;
+	use crate::sumcheck::{
+		PaddedSumcheckDecorator, bivariate_product_evaluator::bivariate_product_prover,
+		prove_single,
+	};
+
+	type StdChallenger = HasherChallenger<sha2::Sha256>;
+
+	#[test]
+	fn grouped_roundtrip_supports_unequal_native_variable_counts() {
+		let alloc = GlobalAllocator;
+		let mut rng = StdRng::seed_from_u64(0);
+		let short_n = 4;
+		let long_n = 7;
+
+		let a0 = random_field_buffer::<P>(&mut rng, short_n);
+		let b0 = random_field_buffer::<P>(&mut rng, short_n);
+		let a1 = random_field_buffer::<P>(&mut rng, long_n);
+		let b1 = random_field_buffer::<P>(&mut rng, long_n);
+		let claim0 = inner_product_par(&a0, &b0);
+		let claim1 = inner_product_par(&a1, &b1);
+		let aggregate_claim = claim0 + claim1;
+
+		let short = PaddedSumcheckDecorator::new(
+			bivariate_product_prover(&alloc, [a0, b0], claim0),
+			long_n - short_n,
+			vec![claim0],
+		);
+		let long = PaddedSumcheckDecorator::new(
+			bivariate_product_prover(&alloc, [a1, b1], claim1),
+			0,
+			vec![claim1],
+		);
+		let grouped =
+			GroupedSumcheckProver::new([(claim0, short), (claim1, long)], aggregate_claim);
+
+		let mut prover_transcript = ProverTranscript::new(StdChallenger::default());
+		let output = prove_single(grouped, &mut prover_transcript);
+		assert_eq!(output.multilinear_evals.len(), 4);
+
+		let mut verifier_transcript = prover_transcript.into_verifier();
+		let reduced = verify(long_n, 2, aggregate_claim, &mut verifier_transcript)
+			.expect("the aggregate sumcheck must verify");
+		let [a0_eval, b0_eval, a1_eval, b1_eval]: [F; 4] = output
+			.multilinear_evals
+			.try_into()
+			.expect("two product terms emit four multilinear evaluations");
+		let mut variable_point = reduced.challenges;
+		variable_point.reverse();
+		let padding = binius_math::multilinear::eq::eq_ind_zero(&variable_point[short_n..]);
+		assert_eq!(reduced.eval, a0_eval * b0_eval * padding + a1_eval * b1_eval);
+	}
+
+	#[test]
+	#[should_panic(expected = "term claims must sum")]
+	fn wrong_aggregate_claim_fails_closed() {
+		let alloc = GlobalAllocator;
+		let mut rng = StdRng::seed_from_u64(1);
+		let a = random_field_buffer::<P>(&mut rng, 3);
+		let b = random_field_buffer::<P>(&mut rng, 3);
+		let claim = inner_product_par(&a, &b);
+		let inner = bivariate_product_prover(&alloc, [a, b], claim);
+		let _ = GroupedSumcheckProver::new([(claim, inner)], claim + F::ONE);
+	}
+}
