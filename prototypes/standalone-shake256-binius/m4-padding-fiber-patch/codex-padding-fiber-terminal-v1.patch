+// Copyright 2026 The Binius Developers
+
+//! Exact PCS-only permutation that groups a natural message's zero padding into FRI fibers.
+
+/// Derived compact-terminal layout for one padding-fiber oracle.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct PaddingFiberLayout {
+	/// Natural message dimension.
+	pub log_msg_len: usize,
+	/// Number of message variables eliminated before the terminal message.
+	pub fold_vars: usize,
+	/// Number of leading natural message values that may be nonzero.
+	pub active_values: usize,
+	/// Number of terminal-message values carried on the wire.
+	pub terminal_wire_values: usize,
+}
+
+/// Reverses exactly `bits` low bits of `value`.
+const fn reverse_low_bits(value: usize, bits: usize) -> usize {
+	if bits == 0 {
+		0
+	} else {
+		value.reverse_bits() >> (usize::BITS as usize - bits)
+	}
+}
+
+/// Maps one natural multilinear index into padding-fiber PCS order.
+///
+/// For a message with `n = log_len` variables whose first `fold_vars = f` variables will be
+/// eliminated before the terminal FRI message, write `i = q·2^f + s`. The new index is
+///
+/// `P(i) = bit_reverse_{n-f}(q) + 2^{n-f}·s`.
+///
+/// The Reed–Solomon encoder subsequently bit-reverses all `n` index bits, giving
+/// `bit_reverse_n(P(i)) = q·2^f + bit_reverse_f(s)`. Consequently the `2^f` values belonging to
+/// one natural block `q` form one contiguous fold fiber.
+pub fn padding_fiber_index(index: usize, log_len: usize, fold_vars: usize) -> usize {
+	assert!(fold_vars <= log_len, "fold variables must fit the message dimension");
+	assert!(index < 1 << log_len, "index must fit the message dimension");
+	let terminal_vars = log_len - fold_vars;
+	let fiber_mask = (1 << fold_vars) - 1;
+	let block = index >> fold_vars;
+	let fiber = index & fiber_mask;
+	reverse_low_bits(block, terminal_vars) | (fiber << terminal_vars)
+}
+
+/// Inverse of [`padding_fiber_index`].
+pub fn inverse_padding_fiber_index(index: usize, log_len: usize, fold_vars: usize) -> usize {
+	assert!(fold_vars <= log_len, "fold variables must fit the message dimension");
+	assert!(index < 1 << log_len, "index must fit the message dimension");
+	let terminal_vars = log_len - fold_vars;
+	let terminal_mask = (1 << terminal_vars) - 1;
+	let block = reverse_low_bits(index & terminal_mask, terminal_vars);
+	let fiber = index >> terminal_vars;
+	(block << fold_vars) | fiber
+}
+
+/// Transforms a low-to-high multilinear evaluation point for padding-fiber PCS order.
+///
+/// If the natural point is `[r_0, …, r_{n-1}]`, the returned point is
+/// `[r_{n-1}, …, r_f, r_0, …, r_{f-1}]`. Evaluating the permuted message there is exactly the
+/// same as evaluating the natural message at the original point.
+pub fn padding_fiber_point<T: Clone>(point: &[T], fold_vars: usize) -> Vec<T> {
+	assert!(fold_vars <= point.len(), "fold variables must fit the evaluation point");
+	point[fold_vars..]
+		.iter()
+		.rev()
+		.chain(&point[..fold_vars])
+		.cloned()
+		.collect()
+}
+
+#[cfg(test)]
+mod tests {
+	use binius_field::{BinaryField128bGhash as B128, Field};
+	use binius_math::{
+		bit_reverse::bit_reverse_indices, multilinear::evaluate::evaluate_inplace_scalars,
+	};
+
+	use super::*;
+
+	#[test]
+	fn padding_fiber_permutation_is_a_bijection() {
+		for log_len in 0..=14 {
+			for fold_vars in 0..=log_len {
+				let mut seen = vec![false; 1 << log_len];
+				for index in 0..1 << log_len {
+					let permuted = padding_fiber_index(index, log_len, fold_vars);
+					assert!(!seen[permuted]);
+					seen[permuted] = true;
+					assert_eq!(inverse_padding_fiber_index(permuted, log_len, fold_vars), index);
+				}
+				assert!(seen.into_iter().all(|entry| entry));
+			}
+		}
+	}
+
+	#[test]
+	fn padding_fiber_permutation_preserves_multilinear_evaluation() {
+		let log_len = 8;
+		let fold_vars = 3;
+		let natural = (0..1 << log_len)
+			.map(|i| B128::new((i as u128 + 1).pow(3)))
+			.collect::<Vec<_>>();
+		let point = (0..log_len)
+			.map(|i| B128::new((17 + i) as u128))
+			.collect::<Vec<_>>();
+		let mut permuted = vec![B128::ZERO; natural.len()];
+		for (index, &value) in natural.iter().enumerate() {
+			permuted[padding_fiber_index(index, log_len, fold_vars)] = value;
+		}
+
+		let natural_eval = evaluate_inplace_scalars(natural, &point);
+		let permuted_eval =
+			evaluate_inplace_scalars(permuted, &padding_fiber_point(&point, fold_vars));
+		assert_eq!(permuted_eval, natural_eval);
+	}
+
+	#[test]
+	fn encoder_bit_reversal_groups_natural_fibers() {
+		let (log_len, fold_vars) = (14, 4);
+		for index in 0..1 << log_len {
+			let encoded = reverse_low_bits(padding_fiber_index(index, log_len, fold_vars), log_len);
+			let want = ((index >> fold_vars) << fold_vars)
+				| reverse_low_bits(index & ((1 << fold_vars) - 1), fold_vars);
+			assert_eq!(encoded, want);
+		}
+	}
+
+	#[test]
+	fn pay1x2_padding_fibers_give_an_exact_zero_terminal_suffix() {
+		let (log_len, fold_vars, active_values) = (14_usize, 4_usize, 12_486_usize);
+		let terminal_wire_values = active_values.div_ceil(1 << fold_vars);
+		assert_eq!(terminal_wire_values, 781);
+
+		let mut natural = vec![B128::ZERO; 1 << log_len];
+		for (index, value) in natural[..active_values].iter_mut().enumerate() {
+			*value = B128::new((index + 1) as u128);
+		}
+		let mut encoded_message = vec![B128::ZERO; natural.len()];
+		for (index, value) in natural.into_iter().enumerate() {
+			encoded_message[padding_fiber_index(index, log_len, fold_vars)] = value;
+		}
+		// `encode_batch` performs this exact message permutation before its NTT. Folding the first
+		// four encoded variables therefore evaluates each contiguous sixteen-value fiber.
+		bit_reverse_indices(&mut encoded_message);
+		let fold_point = (0..fold_vars)
+			.map(|i| B128::new((41 + i) as u128))
+			.collect::<Vec<_>>();
+		let terminal = encoded_message
+			.chunks(1 << fold_vars)
+			.map(|fiber| evaluate_inplace_scalars(fiber.to_vec(), &fold_point))
+			.collect::<Vec<_>>();
+
+		assert_eq!(terminal.len(), 1 << (log_len - fold_vars));
+		assert!(
+			terminal[terminal_wire_values..]
+				.iter()
+				.all(|&value| value == B128::ZERO)
+		);
+	}
+}
