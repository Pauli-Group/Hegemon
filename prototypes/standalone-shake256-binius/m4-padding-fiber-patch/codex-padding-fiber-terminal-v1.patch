+/// Copies a natural oracle into the exact PCS permutation that groups its zero padding into full
+/// terminal FRI fibers.
+fn permute_padding_fibers<P, A>(
+	alloc: &A,
+	message: FieldSlice<P>,
+	layout: PaddingFiberLayout,
+) -> FieldBuffer<P, A::Vec<P>>
+where
+	P: PackedField,
+	A: Allocator,
+{
+	assert_eq!(message.log_len(), layout.log_msg_len);
+	assert!(
+		message
+			.iter_scalars()
+			.skip(layout.active_values)
+			.all(|value| value == P::Scalar::ZERO),
+		"padding-fiber oracle suffix must be canonical zero"
+	);
+
+	let mut permuted = vec![P::Scalar::ZERO; message.len()];
+	for (index, value) in message.iter_scalars().enumerate() {
+		permuted[padding_fiber_index(index, layout.log_msg_len, layout.fold_vars)] = value;
+	}
+	FieldBuffer::from_values_in(alloc, &permuted)
+}
