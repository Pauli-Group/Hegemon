+
+	fn recv_committed_vector_with_known_zero_suffix(
+		&mut self,
+		commitment: &Self::Commitment,
+		wire_values: usize,
+	) -> Result<Vec<F>, Error> {
+		let len = commitment.leaf_size << commitment.commitment.depth;
+		assert!(wire_values <= len, "wire prefix must fit the committed vector");
+		let mut data = self
+			.transcript
+			.borrow_mut()
+			.decommitment()
+			.read_scalar_slice::<F>(wire_values)?;
+		data.resize(len, F::ZERO);
+		self.scheme
+			.verify_vector(&commitment.commitment.root, &data, commitment.leaf_size)?;
+		Ok(data)
+	}
 }
 
