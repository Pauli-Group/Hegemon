+/// Reconstructs the rate-expanded terminal codeword from the exact representation produced by
+/// `FRIFoldProver::terminal_message`. The serialized block is the inverse-NTT output's first
+/// (bit-reversed) message block; repeating it supplies the skipped rate layers, and the forward
+/// Gao–Mateer butterflies restore the committed codeword. The message commitment therefore binds
+/// every reconstructed terminal entry without sending the redundant repetitions.
+fn encode_terminal_message<F, E>(
+	domain_context: &impl DomainContext<Field = F>,
+	log_terminal_dim: usize,
+	log_inv_rate: usize,
+	message: &[E],
+) -> Vec<E>
+where
+	F: BinaryField,
+	E: FieldOps<Scalar = F> + From<F>,
+{
+	let message_len = 1 << log_terminal_dim;
+	assert_eq!(message.len(), message_len);
+	let log_len = log_terminal_dim + log_inv_rate;
+	assert!(
+		log_len <= domain_context.log_domain_size(),
+		"terminal codeword domain exceeds the verifier's Gao-Mateer domain"
+	);
+	let mut codeword = message
+		.iter()
+		.cloned()
+		.cycle()
+		.take(1 << log_len)
+		.collect::<Vec<_>>();
+
+	for layer in log_inv_rate..log_len {
+		let num_blocks = 1 << layer;
+		let block_size_half = 1 << (log_len - layer - 1);
+		for block in 0..num_blocks {
+			let twiddle = E::from(domain_context.twiddle(layer, block));
+			let block_start = block << (log_len - layer);
+			for index in 0..block_size_half {
+				let index_0 = block_start + index;
+				let index_1 = block_size_half | index_0;
+				let mut u = codeword[index_0].clone();
+				let mut v = codeword[index_1].clone();
+				u += v.clone() * twiddle.clone();
+				v += u.clone();
+				codeword[index_0] = u;
+				codeword[index_1] = v;
+			}
+		}
+	}
+
+	codeword
+}
