+		let (block_point, prefix_point) = point.split_at(block_log_len);
+		let selector = prefix_point
+			.iter()
+			.enumerate()
+			.map(|(index, coordinate)| {
+				if ((prefix >> index) & 1) == 1 {
+					coordinate.clone()
+				} else {
+					E::one() - coordinate.clone()
+				}
+			})
+			.product::<E>();
+		selector * base(block_point)
+	})
+}
+
+/// Returns a closure for the mask tensor embedded in the private oracle's high-bit tail.
+///
+/// The prover stores the `2^(m_n + m_d)` mask coefficients at indices
+/// `[2^log_private - 2^(m_n + m_d), 2^log_private)`. The high-bit selector is therefore
+/// `prod(point[mask_log_len..])`, which is one on that Boolean tail and zero elsewhere.
+fn embedded_mask_transparent<F: Field, E: FieldOps + 'static>(
+	cs: &ConstraintSystemPadded<F>,
+	r_x: &[E],
+) -> binius_iop::channel::TransparentEvalFn<E> {
+	let (m_n, m_d) = cs.mask_dims();
+	let mask_log_len = m_n + m_d;
+	let private_log_len = cs.log_private() as usize;
+	assert!(mask_log_len <= private_log_len, "mask tensor must fit in the private oracle");
+	let n_vars = r_x.len();
+	let mask_degree = 2; // quadratic composition
+	let r_x = r_x.to_vec();
+
+	Box::new(move |point: &[E]| {
+		assert_eq!(point.len(), private_log_len);
+		let (mask_point, selector_point) = point.split_at(mask_log_len);
+		let (query_k, query_j) = mask_point.split_at(m_d);
+		let selector = selector_point.iter().cloned().product::<E>();
+
+		selector * mlecheck::libra_eval(&r_x, query_j, query_k, n_vars, mask_degree)
+	})
+}
