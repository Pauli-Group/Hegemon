@@ -136,6 +137,60 @@ where
 	fn compute_leaf_digest(&self, values: &[T]) -> Result<Output<H::LeafHash>, Error> {
 		Ok(hash_serialize::<T, H::LeafHash>(values)?)
 	}
+
+	/// Verifies a canonical compact opening for distinct, sorted leaves.
+	///
+	/// The proof carries only sibling nodes whose subtree has no opened leaf. Node positions are
+	/// reconstructed from `indices`; siblings are consumed bottom-up and by ascending node index,
+	/// exactly matching the prover channel. This is the standard Merkle multiproof frontier and
+	/// authenticates the same leaf values to the same root as independent branches.
+	pub fn verify_compact_opening<B: Buf>(
+		&self,
+		root: &Output<H::LeafHash>,
+		tree_depth: usize,
+		indices: &[usize],
+		leaves: &[Vec<T>],
+		proof: &mut TranscriptReader<B>,
+	) -> Result<(), Error>
+	where
+		T: Clone,
+	{
+		assert_eq!(indices.len(), leaves.len());
+		assert!(!indices.is_empty(), "precondition: at least one leaf must be opened");
+		assert!(indices.windows(2).all(|pair| pair[0] < pair[1]));
+		assert!(indices.iter().all(|&index| index < 1 << tree_depth));
+
+		let mut live = indices
+			.iter()
+			.copied()
+			.zip(leaves)
+			.map(|(index, leaf)| Ok((index, self.compute_leaf_digest(leaf)?)))
+			.collect::<Result<BTreeMap<_, _>, Error>>()?;
+		for _level in 0..tree_depth {
+			let mut parents = BTreeMap::new();
+			for (&index, digest) in &live {
+				let sibling_index = index ^ 1;
+				if index & 1 == 1 && live.contains_key(&sibling_index) {
+					continue;
+				}
+				let sibling = match live.get(&sibling_index) {
+					Some(sibling) => sibling.clone(),
+					None => proof.read::<Output<H::LeafHash>>()?,
+				};
+				let parent = self.compression.compress(if index & 1 == 0 {
+					[digest.clone(), sibling]
+				} else {
+					[sibling, digest.clone()]
+				});
+				parents.insert(index >> 1, parent);
+			}
+			live = parents;
+		}
+		if live.len() != 1 || live.get(&0) != Some(root) {
+			return Err(VerificationError::InvalidProof.into());
+		}
+		Ok(())
+	}
 }
 
