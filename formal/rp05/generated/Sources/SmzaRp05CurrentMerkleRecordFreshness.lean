import SmzaRp05ExecutableMerkleVerifier
import SmzaRp05ExecutableMerklePaths
import SmzaRp05CurrentFppRecordFreshness
import SmzaRp05FilteredReadback

/-! # Fresh-statement classification of the actual Merkle attempt log

Every leaf read generated by the executable Merkle verifier is framed from
its single binding field. All level/root reads use the distinct node/root
frames. The theorem below classifies the whole instrumented attempt log; it
does not assume that the attempt accepts.
-/

namespace HegemonCrypto.SmallWood.SmzaRp05CurrentMerkleRecordFreshness

open HegemonCrypto.CanonicalBytes
open SmzaRp05ExecutableMerkleVerifier
open SmzaRp05LeafNamespace
open SmzaRp05FilteredReadback
  (globalLeafStatement fixed_context_leaf_is_global_statement)
open SmzaRp05CurrentFppRecordFreshness (nonleaf_frame_has_no_statement)

noncomputable section
set_option autoImplicit false
set_option maxRecDepth 12000

private theorem record_bind_none {α β : Type} (oracle : Oracle)
    (program : Program α) (next : α → Program β)
    (failed : program.eval oracle = none) :
    (program.bind next).record oracle = (none, (program.record oracle).2) := by
  induction program with
  | done result => cases result <;> simp [Program.eval, Program.bind, Program.record] at *
  | read input cont ih =>
      have tailFailed : (cont (oracle input)).eval oracle = none := by
        simpa [Program.eval] using failed
      have tail := ih (oracle input) tailFailed
      simpa [Program.bind, Program.record] using congrArg
        (fun out : Option β × Log => (out.1, (input, oracle input) :: out.2)) tail

private theorem record_bind_done_log_eq {α β : Type} (oracle : Oracle)
    (program : Program α) (finish : α → β) :
    ((program.bind fun value => (.done (some (finish value)) : Program β)).record oracle).2 =
      (program.record oracle).2 := by
  cases ran : program.eval oracle with
  | none => rw [record_bind_none oracle program _ ran]
  | some value =>
      rw [Program.record_bind_success oracle program
        (fun value => (.done (some (finish value)) : Program β)) value ran]
      simp [Program.record]

private theorem sequence_log_entry {α : Type} (oracle : Oracle) :
    ∀ (count : Nat) (entries : Fin count → Program α)
      (call : V8SmzaOracleParser.RawInput × V8SmzaOracleParser.RawDigest),
      call ∈ ((SmzaRp05ExecutableMerkleVerifier.sequence count entries).record oracle).2 →
      ∃ j, call ∈ ((entries j).record oracle).2 := by
  intro count
  induction count with
  | zero => intro entries call member; simp [SmzaRp05ExecutableMerkleVerifier.sequence, Program.record] at member
  | succ count ih =>
      intro entries call member
      by_cases firstFailed : (entries 0).eval oracle = none
      · have stopped := record_bind_none oracle (entries 0)
          (fun first =>
            (SmzaRp05ExecutableMerkleVerifier.sequence count (fun i => entries i.succ)).bind fun rest =>
              (.done (some (Fin.cons first rest)) : Program (Fin (count + 1) → α)))
          firstFailed
        rw [SmzaRp05ExecutableMerkleVerifier.sequence, stopped] at member
        exact ⟨0, member⟩
      · obtain ⟨first, firstRun⟩ : ∃ first, (entries 0).eval oracle = some first := by
          cases h : (entries 0).eval oracle with
          | none => exact (firstFailed h).elim
          | some first => exact ⟨first, rfl⟩
        rw [SmzaRp05ExecutableMerkleVerifier.sequence, Program.record_bind_success oracle (entries 0)
          (fun first =>
            (SmzaRp05ExecutableMerkleVerifier.sequence count (fun i => entries i.succ)).bind fun rest =>
              (.done (some (Fin.cons first rest)) : Program (Fin (count + 1) → α)))
          first firstRun] at member
        have tailLog := record_bind_done_log_eq oracle
          (SmzaRp05ExecutableMerkleVerifier.sequence count (fun i => entries i.succ))
          (fun rest : Fin count → α =>
            (Fin.cons first rest : Fin (count + 1) → α))
        rw [tailLog] at member
        rcases List.mem_append.mp member with fromFirst | fromRest
        · exact ⟨0, fromFirst⟩
        · obtain ⟨j, inTail⟩ := ih (fun i => entries i.succ) call fromRest
          exact ⟨j.succ, inTail⟩

private theorem initial_slot_call_binding (ns : Namespace) (oracle : Oracle)
    (input : Input) (shape : shapeValid ns input = true)
    (j : Fin 38) (call : V8SmzaOracleParser.RawInput × V8SmzaOracleParser.RawDigest)
    (member : call ∈ ((initialSlot ns input j).record oracle).2) :
    globalLeafStatement ns call.1 = some input.binding := by
  have facts := shape
  simp only [shapeValid, Bool.and_eq_true, decide_eq_true_eq] at facts
  have canonical := facts.1
  by_cases payload : LegacyLeafCanonical input.salt (input.payloads j)
  · by_cases index : V8SmzaOracleParser.wordAt (input.payloads j) 4 = input.indices j
    · have callEq : call =
        (encodeLeaf input.binding (input.payloads j),
          oracle (encodeLeaf input.binding (input.payloads j))) := by
        simpa [initialSlot, canonical, payload, index, ask, Program.bind,
          Program.record] using member
      rw [callEq]
      let leaf : CurrentLeaf ns input.salt :=
        ⟨input.binding, input.payloads j, canonical, payload⟩
      exact fixed_context_leaf_is_global_statement ns input.salt leaf
    · simp [initialSlot, canonical, payload, index, Program.record] at member
  · simp [initialSlot, canonical, payload, Program.record] at member

private theorem shape_input_facts (ns : Namespace) (input : Input)
    (shape : shapeValid ns input = true) :
    ns.canonicalPreamble input.binding = true ∧
      input.salt.length = 32 ∧ input.binding.length = preambleBytes := by
  have facts := shape
  simp only [shapeValid, Bool.and_eq_true, decide_eq_true_eq] at facts
  exact ⟨facts.1, facts.2.1,
    ns.canonicalLength input.binding facts.1⟩

private theorem node_input_has_no_statement (ns : Namespace)
    (left right : V8SmzaOracleParser.RawDigest) :
    globalLeafStatement ns (nodeInput left right) = none := by
  let bytes := List.ofFn left ++ List.ofFn right
  have parsed : V8SmzaOracleParser.parseFramed (nodeInput left right) =
      some (V8SmzaOracleParser.roleName .node, bytes) := by
    unfold nodeInput
    apply V8SmzaOracleParser.frame_roundtrip
    · decide
    · simp
    · simp
  exact nonleaf_frame_has_no_statement ns (nodeInput left right)
    (V8SmzaOracleParser.roleName .node) bytes parsed
    (SmzaRp05LeafNamespace.old_role_ne_v2 .node)

private theorem root_input_has_no_statement (ns : Namespace)
    (salt binding : List Byte) (root : V8SmzaOracleParser.RawDigest)
    (saltLength : salt.length = 32) (bindingLength : binding.length = preambleBytes) :
    globalLeafStatement ns (rootInput salt binding root) = none := by
  let bytes := salt ++ List.ofFn root ++ binding
  have parsed : V8SmzaOracleParser.parseFramed (rootInput salt binding root) =
      some (V8SmzaOracleParser.roleName .root, bytes) := by
    unfold rootInput
    apply V8SmzaOracleParser.frame_roundtrip
    · decide
    · simp [saltLength, bindingLength, preambleBytes]
    · simp [saltLength, bindingLength, preambleBytes]
  exact nonleaf_frame_has_no_statement ns (rootInput salt binding root)
    (V8SmzaOracleParser.roleName .root) bytes parsed
    (SmzaRp05LeafNamespace.old_role_ne_v2 .root)

private theorem next_slot_call_nonleaf (ns : Namespace) (oracle : Oracle)
    (state : State) (j : Fin 38) (call : V8SmzaOracleParser.RawInput × V8SmzaOracleParser.RawDigest)
    (member : call ∈ ((nextSlot state j).record oracle).2) :
    globalLeafStatement ns call.1 = none := by
  cases selected : selectedSibling state j with
  | none => simp [nextSlot, selected, Program.record] at member
  | some pair =>
      rcases pair with ⟨sibling, remaining⟩
      have callEq : call =
        (if (state j).index % 2 = 0 then nodeInput (state j).hash sibling
          else nodeInput sibling (state j).hash,
          oracle (if (state j).index % 2 = 0 then nodeInput (state j).hash sibling
            else nodeInput sibling (state j).hash)) := by
        simpa [nextSlot, selected, ask, Program.bind, Program.record] using member
      rw [callEq]
      split_ifs
      · exact node_input_has_no_statement ns _ _
      · exact node_input_has_no_statement ns _ _

private theorem level_call_nonleaf (ns : Namespace) (oracle : Oracle)
    (state : State) (call : V8SmzaOracleParser.RawInput × V8SmzaOracleParser.RawDigest)
    (member : call ∈ ((level state).record oracle).2) :
    globalLeafStatement ns call.1 = none := by
  by_cases consistent : duplicateConsistent state = true
  · have sequenceMember : call ∈
      ((SmzaRp05ExecutableMerkleVerifier.sequence 38 (nextSlot state)).record oracle).2 := by
      simpa [level, consistent, Program.record] using member
    obtain ⟨j, slotMember⟩ := sequence_log_entry oracle 38
      (nextSlot state) call sequenceMember
    exact next_slot_call_nonleaf ns oracle state j call slotMember
  · simp [level, consistent, Program.record] at member

private theorem levels_call_nonleaf (ns : Namespace) (oracle : Oracle) :
    ∀ depth state call,
      call ∈ ((levels depth state).record oracle).2 →
      globalLeafStatement ns call.1 = none := by
  intro depth
  induction depth with
  | zero => intro state call member; simp [levels, Program.record] at member
  | succ depth ih =>
      intro state call member
      by_cases failed : (level state).eval oracle = none
      · have stopped := record_bind_none oracle (level state)
          (levels depth) failed
        rw [levels, stopped] at member
        exact level_call_nonleaf ns oracle state call member
      · obtain ⟨middle, stepped⟩ : ∃ middle, (level state).eval oracle = some middle := by
          cases h : (level state).eval oracle with
          | none => exact (failed h).elim
          | some middle => exact ⟨middle, rfl⟩
        rw [levels, Program.record_bind_success oracle (level state)
          (levels depth) middle stepped] at member
        rcases List.mem_append.mp member with first | rest
        · exact level_call_nonleaf ns oracle state call first
        · exact ih middle call rest

private theorem finish_call_nonleaf_oracle (ns : Namespace) (input : Input)
    (shape : shapeValid ns input = true) (oracle : Oracle) (state : State)
    (call : V8SmzaOracleParser.RawInput × V8SmzaOracleParser.RawDigest)
    (member : call ∈ ((finish input state).record oracle).2) :
    globalLeafStatement ns call.1 = none := by
  by_cases valid : finalValid state = true
  · have callEq : call =
      (rootInput input.salt input.binding (state 0).hash,
        oracle (rootInput input.salt input.binding (state 0).hash)) := by
      simpa [finish, valid, ask, Program.record] using member
    rw [callEq]
    have shapeFacts := shape_input_facts ns input shape
    exact root_input_has_no_statement ns input.salt input.binding (state 0).hash
      shapeFacts.2.1 shapeFacts.2.2
  · simp [finish, valid, Program.record] at member

private theorem continuation_call_nonleaf (ns : Namespace) (oracle : Oracle)
    (input : Input) (shape : shapeValid ns input = true) (state : State)
    (call : V8SmzaOracleParser.RawInput × V8SmzaOracleParser.RawDigest)
    (member : call ∈ (((levels 23 state).bind (finish input)).record oracle).2) :
    globalLeafStatement ns call.1 = none := by
  by_cases failed : (levels 23 state).eval oracle = none
  · have stopped := record_bind_none oracle (levels 23 state) (finish input) failed
    rw [stopped] at member
    exact levels_call_nonleaf ns oracle 23 state call member
  · obtain ⟨final, stepped⟩ : ∃ final, (levels 23 state).eval oracle = some final := by
      cases h : (levels 23 state).eval oracle with
      | none => exact (failed h).elim
      | some final => exact ⟨final, rfl⟩
    rw [Program.record_bind_success oracle (levels 23 state) (finish input) final stepped]
      at member
    rcases List.mem_append.mp member with first | last
    · exact levels_call_nonleaf ns oracle 23 state call first
    · exact finish_call_nonleaf_oracle ns input shape oracle final call last

/-- Every call made by the actual executable Merkle attempt is either a
current-statement leaf read or a nonleaf read. The property holds even for
rejected attempts: failed guards simply shorten the recorded prefix. -/
theorem recorded_attempt_calls_current_statement_or_nonleaf
    (ns : Namespace) (oracle : Oracle) (input : Input) :
    ∀ call ∈ (recordedAttempt ns oracle input).2,
      globalLeafStatement ns call.1 = none ∨
        globalLeafStatement ns call.1 = some input.binding := by
  intro call member
  by_cases shape : shapeValid ns input = true
  · have canonical : ns.canonicalPreamble input.binding = true := by
      exact (shape_input_facts ns input shape).1
    have initialProp : ∀ j : Fin 38, ∀ call,
        call ∈ ((initialSlot ns input j).record oracle).2 →
        globalLeafStatement ns call.1 = some input.binding := by
      intro j call callMember
      exact initial_slot_call_binding ns oracle input shape j call callMember
    have sequenceProp : ∀ call,
        call ∈ ((SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input)).record oracle).2 →
        globalLeafStatement ns call.1 = some input.binding := by
      intro call callMember
      obtain ⟨j, slotMember⟩ := sequence_log_entry oracle 38
        (initialSlot ns input) call callMember
      exact initialProp j call slotMember
    have continuationProp : ∀ state call,
        call ∈ (((levels 23 state).bind (finish input)).record oracle).2 →
        globalLeafStatement ns call.1 = none := by
      intro state call callMember
      exact continuation_call_nonleaf ns oracle input shape state call callMember
    by_cases initialFailed :
        (SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input)).eval oracle = none
    · have stopped := record_bind_none oracle
        (SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input))
        (fun initial => (levels 23 initial).bind (finish input)) initialFailed
      have top : merkleProgram ns input =
          (SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input)).bind
            (fun initial => (levels 23 initial).bind (finish input)) := by
        simp [merkleProgram, shape]
      have attemptLog :
          (recordedAttempt ns oracle input).2 =
            ((SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input)).record oracle).2 := by
        simp only [recordedAttempt]
        rw [top, stopped]
      rw [attemptLog] at member
      exact Or.inr (sequenceProp call member)
    · obtain ⟨initial, initialRun⟩ : ∃ initial,
        (SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input)).eval oracle = some initial := by
        cases h : (SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input)).eval oracle with
        | none => exact (initialFailed h).elim
        | some initial => exact ⟨initial, rfl⟩
      have rest := Program.record_bind_success oracle
        (SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input))
        (fun initial => (levels 23 initial).bind (finish input)) initial initialRun
      have top : merkleProgram ns input =
          (SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input)).bind
            (fun initial => (levels 23 initial).bind (finish input)) := by
        simp [merkleProgram, shape]
      have attemptLog :
          (recordedAttempt ns oracle input).2 =
            (((SmzaRp05ExecutableMerkleVerifier.sequence 38 (initialSlot ns input)).record oracle).2 ++
              (((levels 23 initial).bind (finish input)).record oracle).2) := by
        simp only [recordedAttempt]
        rw [top, rest]
      rw [attemptLog] at member
      rcases List.mem_append.mp member with first | later
      · exact Or.inr (sequenceProp call first)
      · exact Or.inl (continuationProp initial call later)
  · have noCalls : (recordedAttempt ns oracle input).2 = [] := by
      cases h : shapeValid ns input <;>
        simp_all [recordedAttempt, merkleProgram, Program.record]
    simp [noCalls] at member

end
end HegemonCrypto.SmallWood.SmzaRp05CurrentMerkleRecordFreshness
