def hashRow (group wire : Nat) : Nat := 299 + 182 * group + wire

def hashRootPair (group wire : Nat) : Nat × Nat :=
  hashRootPairs.getD (166 * group + wire) (0, 0)

def HashRootValid (group wire : Nat) : Prop :=
  let pair := hashRootPair group wire
  exactNonlinearExpressions[pair.1]? =
    some (.sub (124 + hashRow group wire) pair.2) ∧
  exactNonlinearExpressions[124 + hashRow group wire]? =
    some (.witnessRow (hashRow group wire)) ∧
  pair.1 ∈ exactNonlinearRoots ∧
  283 + 182 * group ≤ (exactSpan pair.2).1 ∧
  (exactSpan pair.2).2 ≤ hashRow group wire

instance (group wire : Nat) : Decidable (HashRootValid group wire) := by
  unfold HashRootValid
  infer_instance


