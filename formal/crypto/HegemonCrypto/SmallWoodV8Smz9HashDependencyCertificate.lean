theorem exact_span_certificate {node : Nat} {expression : FieldExpression}
    (found : exactNonlinearExpressions[node]? = some expression) :
    exactSpan node = expressionSpan exactSpan expression := by
  have lengthEq : exactNonlinearExpressions.length = 8271 :=
    exact_program_component_inventory.2.2.2.2.2.2.1
  have nodeBound := (List.getElem?_eq_some_iff.mp found).choose
  have blockBound : node / 128 < 65 := by omega
  have checked := all_span_blocks_checked blockBound
  have indexEq : 128 * (node / 128) + node % 128 = node := Nat.div_add_mod node 128
  have nodeInBlock :
      ((exactNonlinearExpressions.drop (128 * (node / 128))).take 128)[node % 128]? =
        some expression := by
    rw [List.getElem?_take_of_lt (Nat.mod_lt _ (by decide)), List.getElem?_drop, indexEq]
    exact found
  have allNodes := (checkIndexed_eq_true _ _ _).mp checked
  have equation := allNodes (node % 128) expression nodeInBlock
  simpa only [indexEq, decide_eq_true_eq] using equation

