/-- Half-open row dependency interval; (686,0) is empty and (0,687) out of range. -/
abbrev Span := Nat × Nat

def joinSpan (a b : Span) : Span := (min a.1 b.1, max a.2 b.2)

def expressionSpan (spans : Nat → Span) : FieldExpression → Span
  | .constant _ => (686, 0)
  | .witnessRow row => (row, row + 1)
  | .add a b | .sub a b | .mul a b => joinSpan (spans a) (spans b)
  | .neg a => spans a
  | _ => (0, 687)

