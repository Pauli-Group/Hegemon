theorem burnAfterNode3_trace_checked :
    ∀ index : Fin 31, certificateStep index.val (burnAfterNode3Trace.getD index.val []) =
      burnAfterNode3Trace.getD (index.val + 1) [] := by
  decide

theorem burnAfterNode3_checked : poseidon2V8Compress14 (stablecoinV8DomainStateNode0 + 3)
    [901, 902, 903, 904, 905, 906, 907] burnAfterNode2 = burnAfterNode3 := by
  change (Poseidon2Width16Kernel.permutation (burnAfterNode3Trace.getD 0 [])).take 7 =
    (burnAfterNode3Trace.getD 31 []).take 7
  exact congrArg (fun values : List Nat => values.take 7)
    (checked_permutation _ _ rfl burnAfterNode3_trace_checked)

