    exactV8StablecoinRoot 1001 burnConfigDigest stablecoinV8BurnKatAfter
      stablecoinV8KatSiblings = burnAfterRoot := by
  change (poseidon2V8Compress14 (stablecoinV8DomainStateNode0 + 3) [901, 902, 903, 904, 905, 906, 907] (poseidon2V8Compress14 (stablecoinV8DomainStateNode0 + 2) (poseidon2V8Compress14 (stablecoinV8DomainStateNode0 + 1) (poseidon2V8Compress14 (stablecoinV8DomainStateNode0 + 0) [601, 602, 603, 604, 605, 606, 607] (poseidon2V8Compress14 stablecoinV8DomainStateLeaf burnConfigDigest [2, 100, 975, 10, 9, 0, 0])) [701, 702, 703, 704, 705, 706, 707]) [801, 802, 803, 804, 805, 806, 807])) = burnAfterRoot
