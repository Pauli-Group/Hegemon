open Hegemon.Transaction hiding Digest

/-- A finite arithmetic certificate step, composed into the unchanged kernel below. -/
def certificateStep (index : Nat) (state : List Nat) : List Nat :=
  if index = 0 then Poseidon2Width16Kernel.externalLinearLayer state
  else if index < 5 then Poseidon2Width16Kernel.externalRound state
    (Poseidon2Width16Kernel.externalRoundConstantsInitial.getD (index - 1) [])
  else if index < 27 then Poseidon2Width16Kernel.internalRound state
    (Poseidon2Width16Kernel.internalRoundConstants.getD (index - 5) 0)
  else Poseidon2Width16Kernel.externalRound state
    (Poseidon2Width16Kernel.externalRoundConstantsTerminal.getD (index - 27) [])

def certificateState (initial : List Nat) : Nat → List Nat
  | 0 => initial
  | index + 1 => certificateStep index (certificateState initial index)

theorem certificate_state_is_kernel (initial : List Nat) :
    certificateState initial 31 = Poseidon2Width16Kernel.permutation initial := by
  rfl

theorem checked_permutation (initial : List Nat) (trace : List (List Nat))
    (first : initial = trace.getD 0 [])
    (checked : ∀ index : Fin 31, certificateStep index.val (trace.getD index.val []) =
      trace.getD (index.val + 1) []) :
    Poseidon2Width16Kernel.permutation initial = trace.getD 31 [] := by
  have states : ∀ index, index ≤ 31 →
      certificateState initial index = trace.getD index [] := by
    intro index bound
    induction index with
    | zero => exact first
    | succ index ih =>
        change certificateStep index (certificateState initial index) = _
        rw [ih (by omega)]
        exact checked ⟨index, by omega⟩
  rw [← certificate_state_is_kernel]
  exact states 31 (by decide)

