section ConcreteDecidability

local instance (word : Nat) : Decidable (BooleanWord word) := by
  unfold BooleanWord
  infer_instance

local instance (count : Nat) (words : List Nat) : Decidable (ExactWords count words) := by
  unfold ExactWords
  infer_instance

local instance (words : List Nat) : Decidable (ZeroWords words) := by
  unfold ZeroWords
  infer_instance

local instance (words : List Nat) : Decidable (NonzeroWords words) := by
  unfold NonzeroWords
  infer_instance

local instance (count : Nat) (words : List Nat) : Decidable (StableCanonicalWords count words) := by
  unfold StableCanonicalWords
  infer_instance

local instance (words : List Nat) : Decidable (StableZeroWords words) := by
  unfold StableZeroWords
  infer_instance

local instance (words : List Nat) : Decidable (StableNonzeroWords words) := by
  unfold StableNonzeroWords
  infer_instance

local instance (digests : List Digest) : Decidable (DigestListPairwiseDistinct digests) := by
  unfold DigestListPairwiseDistinct
  infer_instance

local instance (witness : V8StablecoinWitness) :
    Decidable (CanonicalV8StablecoinWitnessEncoding witness) := by
  unfold CanonicalV8StablecoinWitnessEncoding
  infer_instance

local instance (config : V8StablecoinConfigOpening) (before : V8StablecoinCounters) :
    Decidable (exactV8StablecoinCommonValid config before) := by
  unfold exactV8StablecoinCommonValid
  infer_instance

local instance (config : V8StablecoinConfigOpening) (parentHeight : Nat) :
    Decidable (exactV8StablecoinMintPolicyValid config parentHeight) := by
  unfold exactV8StablecoinMintPolicyValid
  infer_instance

local instance (context : V8StablecoinContext) (stable : V8StablecoinPublic)
    (witness : V8StablecoinWitness) :
    Decidable (exactV8StablecoinEnabledValid context stable witness) := by
  unfold exactV8StablecoinEnabledValid
  cases stable.direction <;> infer_instance

theorem burn_stable_transition :
    exactV8StableTransition (derivedRelationContext burnStatement) burnPublic
      burnWitness.stablecoin := by
  change exactV8StablecoinEnabledValid (derivedRelationContext burnStatement) burnPublic
    burnStableWitness
  have before : decodeV8StablecoinBefore burnStableWitness = stablecoinV8KatBefore := by decide
  have siblings : decodeV8StablecoinSiblings burnStableWitness = stablecoinV8KatSiblings := by decide
  unfold exactV8StablecoinEnabledValid
  simp only [before, siblings, burn_config_digest_checked, burnPublic]
  rw [burn_before_root_checked, burn_after_root_checked]
  decide

theorem burn_stable_asset_count_zero :
    burnStatement.balanceAssets.count burnStatement.compatibility.assetId = 0 := by
  decide

/-- The new typed requirement, not a hash or witness-shape failure, rejects the old example. -/
theorem burn_not_canonical_public :
    ¬ CanonicalPublicStatement exactV8SemanticPrimitives burnStatement := by
  intro canonical
  rcases canonical with ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, compatible, _⟩
  have burn := compatible.2.2.2.2.2
  have membership := burn.2.2.2.2.2.2.2.2.2.2
  rw [burn_stable_asset_count_zero] at membership
  exact Nat.zero_ne_one membership

/-- No typed witness can repair the public statement's missing enabled stable asset. -/
theorem burn_not_semantically_valid (witness : V8Witness) :
    ¬ ExactV8RelationSemanticValid burnStatement witness := by
  intro semantic
  exact burn_not_canonical_public semantic.1

theorem burn_canonical_witness : CanonicalWitnessShape burnStatement burnWitness := by
  have inputZero : ZeroInputWitness inactiveInput := by
    unfold ZeroInputWitness ZeroNoteOpening
    decide
  have outputZero : ZeroOutputWitness inactiveOutput := by
    unfold ZeroOutputWitness ZeroNoteOpening
    decide
  refine ⟨rfl, rfl, ?_, ?_, by decide, by decide⟩
  · intro slot bound
    have cases : slot = 0 ∨ slot = 1 := by
      change slot < 2 at bound
      omega
    rcases cases with rfl | rfl <;> exact ⟨rfl, inputZero⟩
  · intro slot bound
    have cases : slot = 0 ∨ slot = 1 := by
      change slot < 2 at bound
      omega
    rcases cases with rfl | rfl <;> exact ⟨rfl, outputZero⟩

theorem burn_cryptographic_links :
    V8CryptographicLinksValid exactV8SemanticPrimitives burnStatement burnWitness := by
  unfold V8CryptographicLinksValid V8AuthorizationValid
  simp only [burnWitness]
  unfold ZeroAccumulator ZeroSignerTags
  decide

theorem burn_balances : V8BalanceValid burnStatement burnWitness := by
  unfold V8BalanceValid
  decide

/-- The original exact fixture remains well formed away from repaired public compatibility. -/
theorem burn_remaining_semantic_conjuncts_hold :
    CanonicalWitnessShape burnStatement burnWitness ∧
      V8CryptographicLinksValid exactV8SemanticPrimitives burnStatement burnWitness ∧
      V8BalanceValid burnStatement burnWitness ∧
      exactV8StableTransition (derivedRelationContext burnStatement) burnPublic
        burnWitness.stablecoin :=
  ⟨burn_canonical_witness, burn_cryptographic_links, burn_balances, burn_stable_transition⟩

end ConcreteDecidability

noncomputable section

/-- The public-only membership product has value 1001 for this statement. -/
theorem burn_membership_root_value (rows : Nat → F)
    (enabled : fieldAt exactNonlinearExpressions
      (fun index => (encodePublicStatement burnStatement |>.getD index 0 : F)) rows 832 = 1) :
    fieldAt exactNonlinearExpressions
      (fun index => (encodePublicStatement burnStatement |>.getD index 0 : F)) rows 1042 = 1001 := by
  let pub := fun index => (encodePublicStatement burnStatement |>.getD index 0 : F)
  change fieldAt exactNonlinearExpressions pub rows 832 = 1 at enabled
  have constants := actual_source_constants pub rows
  have p54 := actual_source_public pub rows (index := 54) (by decide)
  have p55 := actual_source_public pub rows (index := 55) (by decide)
  have p56 := actual_source_public pub rows (index := 56) (by decide)
  have p57 := actual_source_public pub rows (index := 57) (by decide)
  have p59 := actual_source_public pub rows (index := 59) (by decide)
  have n1031 := actual_node_field_equation pub rows (node := 1031) (expression := .sub 63 58) (by decide)
  have n1032 := actual_node_field_equation pub rows (node := 1032) (expression := .selectEqual 58 905 1 1031) (by decide)
  have n1033 := actual_node_field_equation pub rows (node := 1033) (expression := .sub 63 59) (by decide)
  have n1034 := actual_node_field_equation pub rows (node := 1034) (expression := .selectEqual 59 905 1 1033) (by decide)
  have n1035 := actual_node_field_equation pub rows (node := 1035) (expression := .mul 1032 1034) (by decide)
  have n1036 := actual_node_field_equation pub rows (node := 1036) (expression := .sub 63 60) (by decide)
  have n1037 := actual_node_field_equation pub rows (node := 1037) (expression := .selectEqual 60 905 1 1036) (by decide)
  have n1038 := actual_node_field_equation pub rows (node := 1038) (expression := .mul 1035 1037) (by decide)
  have n1039 := actual_node_field_equation pub rows (node := 1039) (expression := .sub 63 61) (by decide)
  have n1040 := actual_node_field_equation pub rows (node := 1040) (expression := .selectEqual 61 905 1 1039) (by decide)
  have n1041 := actual_node_field_equation pub rows (node := 1041) (expression := .mul 1038 1040) (by decide)
  have n1042 := actual_node_field_equation pub rows (node := 1042) (expression := .mul 832 1041) (by decide)
  have pub54 : pub 54 = 0 := by rfl
  have pub55 : pub 55 = (balancePaddingAssetId : F) := by rfl
  have pub56 : pub 56 = (balancePaddingAssetId : F) := by rfl
  have pub57 : pub 57 = (balancePaddingAssetId : F) := by rfl
  have pub59 : pub 59 = 1001 := by rfl
  have paddingNonzero : (0 : F) ≠ (balancePaddingAssetId : F) := by decide
  simp only [expressionField] at n1031 n1032 n1033 n1034 n1035 n1036 n1037 n1038 n1039 n1040 n1041 n1042
  simpa only [n1041, n1040, n1038, n1037, n1035, n1034, n1032, n1031,
    p54, p55, p56, p57, p59, pub54, pub55, pub56, pub57, pub59,
    constants.2.2, constants.2.1, if_pos, if_neg paddingNonzero, sub_zero,
    enabled, mul_one, one_mul] using n1042

/-- No private coordinates or helper choice can satisfy the actual source program. -/
theorem burn_has_no_accepting_packed_witness (packed : List Nat) :
    ¬ hgv8rp03ProgramComponents.AcceptsPacked (encodePublicStatement burnStatement) packed := by
  intro accepted
  have rootZero := accepted_source_root_zero accepted (root := 1042) (by decide)
  have enabled := accepted_source_enabled accepted
  have enabledOne :
      ((encodePublicStatement burnStatement).getD 58 0 : F) = 1 := by rfl
  rw [enabledOne] at enabled
  have rootValue := burn_membership_root_value _ enabled
  have impossible : (1001 : F) = 0 := rootValue.symm.trans rootZero
  exact (by decide : (1001 : F) ≠ 0) impossible

/-- Both targets now reject the same old example; this does not prove universal completeness. -/
theorem stable_asset_membership_repair_closes_burn :
    (∀ witness, ¬ ExactV8RelationSemanticValid burnStatement witness) ∧
      (∀ packed, ¬ hgv8rp03ProgramComponents.AcceptsPacked
        (encodePublicStatement burnStatement) packed) :=
  ⟨burn_not_semantically_valid, burn_has_no_accepting_packed_witness⟩

